services:
  log-sync-service-a:
    build: ./log-sync
    environment:
      RSYNC_SRC: "deploy@192.168.1.10:/var/log/nginx/"
      DIR_LOGS: "serviceA"
      SSH_PORT: "22"
      SSH_KEY_FILE: "/run/secrets/ssh_private_key_a"
      SSH_PASSPHRASE: "your-passphrase-here"
    volumes:
      - ./logs:/data/logs
    secrets:
      - ssh_private_key_a

  log-sync-service-b:
    build: ./log-sync
    environment:
      RSYNC_SRC: "deploy@192.168.1.20:/var/log/nginx/"
      DIR_LOGS: "serviceB"
      SSH_PORT: "22"
      SSH_KEY_FILE: "/run/secrets/ssh_private_key_b"
      SSH_PASSPHRASE: "your-passphrase-here"
    volumes:
      - ./logs:/data/logs
    secrets:
      - ssh_private_key_b

  ai-agent-service-a:
    build: ./ai-agent
    environment:
      SERVICE_NAME: "serviceA"
      ANTHROPIC_API_KEY: "${ANTHROPIC_API_KEY}"
      DISCORD_WEBHOOK_URL: "${DISCORD_WEBHOOK_URL}"
    volumes:
      - ./logs/serviceA:/data/logs/serviceA:ro
      - ./work/serviceA:/data/work/serviceA
      - ./knowledge/serviceA:/data/knowledge
      - ./db:/data/db

  ai-agent-service-b:
    build: ./ai-agent
    environment:
      SERVICE_NAME: "serviceB"
      ANTHROPIC_API_KEY: "${ANTHROPIC_API_KEY}"
      DISCORD_WEBHOOK_URL: "${DISCORD_WEBHOOK_URL}"
    volumes:
      - ./logs/serviceB:/data/logs/serviceB:ro
      - ./work/serviceB:/data/work/serviceB
      - ./knowledge/serviceB:/data/knowledge
      - ./db:/data/db

secrets:
  ssh_private_key_a:
    file: ./secrets/ssh_private_key_a
  ssh_private_key_b:
    file: ./secrets/ssh_private_key_b
