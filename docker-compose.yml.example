services:
  log-sync-service-a:
    build: ./log-sync
    environment:
      RSYNC_SRC: "deploy@192.168.1.10:/var/log/nginx/"
      DIR_LOGS: "serviceA"
      SSH_PORT: "22"
      SSH_KEY_FILE: "/run/secrets/ssh_private_key_a"
      SSH_PASSPHRASE: "your-passphrase-here"
    volumes:
      - ./logs:/data/logs
    secrets:
      - ssh_private_key_a

  log-sync-service-b:
    build: ./log-sync
    environment:
      RSYNC_SRC: "deploy@192.168.1.20:/var/log/nginx/"
      DIR_LOGS: "serviceB"
      SSH_PORT: "22"
      SSH_KEY_FILE: "/run/secrets/ssh_private_key_b"
      SSH_PASSPHRASE: "your-passphrase-here"
    volumes:
      - ./logs:/data/logs
    secrets:
      - ssh_private_key_b

secrets:
  ssh_private_key_a:
    file: ./secrets/ssh_private_key_a
  ssh_private_key_b:
    file: ./secrets/ssh_private_key_b
