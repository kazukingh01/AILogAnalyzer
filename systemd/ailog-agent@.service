[Unit]
Description=AILogAnalyzer - AI agent log analysis (%i)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/AILogAnalyzer
# Usage: analyze.sh --max-lines <N> [--mention <mention>]
ExecStart=/usr/bin/docker exec -T ailog-agent-%i /tools/analyze.sh --max-lines 100000
TimeoutStartSec=600
