[Unit]
Description=AILogAnalyzer - AI agent log analysis (%i)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/AILogAnalyzer
# Usage: analyze.sh <max_extract_lines> [mention]
# Example: analyze.sh 100000 @admin
ExecStart=/usr/bin/docker exec -T ailog-agent-%i /tools/analyze.sh 100000
TimeoutStartSec=600
